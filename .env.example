# Copy this file to .env and fill in your values.
# Never commit .env to git.

# USGS Water Data API key (optional — increases rate limits)
USGS_API_KEY=

# Flask
SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=false

# Cache: how long (seconds) to keep USGS responses before re-fetching
CACHE_TTL_SECONDS=300

# Baseline: how many days of history to use
BASELINE_DAYS=90

# Minimum observations required to build a reliable baseline
MIN_HISTORY_POINTS=30

# How many consecutive unusual observations trigger a break alert
PERSISTENCE_POINTS=3

# Robust z-score threshold for flagging an anomaly
ANOMALY_THRESHOLD=3.5

# SQLite database path (relative to project root)
DATABASE_PATH=data/streamwatch.db
